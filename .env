# ---------------------------------------------------------------
# KTCProject environment variables.
# Copy this file to `.env` and fill in real values for your machine.
#   cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
# ---------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# NOTE: ALLOWED_HOSTS entries are plain hostnames (no scheme, no port, no
# regex) — Django only supports exact matches, a leading-dot wildcard
# (e.g. ".example.com"), or the special "*" (any host).
# We use "*" here because real access control is enforced by
# ALLOWED_IP_RANGES below (the IPWhitelistMiddleware), not by Host header
# checks — this app is only reachable from the internal network anyway.
DJANGO_ALLOWED_HOSTS=*

# --- IP whitelist (restricts the whole site to a company IP range) ---
# Comma-separated list of IPs / CIDR ranges allowed to access the site.
# Leave empty to disable the restriction (default for local dev).
# --- IP whitelist (restricts the whole site to a company IP range) ---
# Comma-separated list of IPs / CIDR ranges allowed to access the site.
# Leave empty to disable the restriction (default for local dev).
# TEMPORARILY DISABLED (empty) so everyone can connect — re-enable later
# by setting e.g. ALLOWED_IP_RANGES=192.168.50.0/24
ALLOWED_IP_RANGES=
# Set to 1 only if the app sits behind a trusted reverse proxy (nginx, etc.)
# that sets X-Forwarded-For itself; otherwise leave 0.
TRUST_X_FORWARDED_FOR=0

# --- Database ---
# Set DB_ENGINE=sqlite to fall back to the old db.sqlite3 file (useful for emergencies).
DB_ENGINE=postgres

POSTGRES_DB=noviraDB
POSTGRES_USER=erfanAdmin
POSTGRES_PASSWORD=erfan315@@
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
