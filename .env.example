# ---------------------------------------------------------------
# KTCProject environment variables.
# Copy this file to `.env` and fill in real values for your machine.
#   cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
# ---------------------------------------------------------------

# --- Django ---
# برای تولید SECRET_KEY جدید این دستور را اجرا کنید:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# این فیلد اجباری است — اگر تنظیم نشود سرور با خطا شروع نمی‌شود.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# --- Database ---
# Set DB_ENGINE=sqlite to fall back to the old db.sqlite3 file (useful for emergencies).
DB_ENGINE=postgres

POSTGRES_DB=ktcproject
POSTGRES_USER=ktc_user
POSTGRES_PASSWORD=ktc_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Private file storage: MinIO / S3-compatible ---
# Keep USE_S3_STORAGE=0 for local MEDIA_ROOT storage.
# Set USE_S3_STORAGE=1 to store uploads in MinIO/S3.
USE_S3_STORAGE=0
AWS_ACCESS_KEY_ID=novira_minio
AWS_SECRET_ACCESS_KEY=novira_minio_password
AWS_STORAGE_BUCKET_NAME=novira-private
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=1
AWS_QUERYSTRING_EXPIRE=300
